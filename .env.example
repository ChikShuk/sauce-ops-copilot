# Copy to .env. Never commit .env.

DATABASE_URL=postgres://sauce:sauce@localhost:5432/sauce_ops

# fallback = deterministic writer, no API key needed, whole product works offline.
# anthropic = real model; ANTHROPIC_API_KEY becomes required.
# This is the DEFAULT. With ENABLE_PROVIDER_TOGGLE on, a row in app_settings
# written by the dashboard overrides it at runtime, for both processes, with no
# restart. Delete that row and the system is back on this value.
LLM_PROVIDER=fallback
ANTHROPIC_API_KEY=

# Demo affordance, not a feature. With this on, an event whose event_id starts
# with "force_fail_" throws after correlation commits, so the retry -> DLQ ->
# findings.status='failed' branch is demonstrable end to end. Takes ~15s of real
# backoff to reach dead_letter. Off by default in code.
ENABLE_DEMO_FAILURE_TRIGGER=true

# Demo affordance, not a feature. Adds the sidebar's model switch and the
# "Re-write summary" button, so a reviewer can see the same finding — same
# evidence, same priority, same drivers — described by the real model and by the
# deterministic writer, without restarting anything. Off by default in code.
# In production, provider selection is deployment config, not a UI control.
ENABLE_PROVIDER_TOGGLE=true
