# Copy to .env. Never commit .env.

DATABASE_URL=postgres://sauce:sauce@localhost:5432/sauce_ops

# fallback = deterministic writer, no API key needed, whole product works offline.
# anthropic = real model; ANTHROPIC_API_KEY becomes required.
LLM_PROVIDER=fallback
ANTHROPIC_API_KEY=

# Demo affordance, not a feature. With this on, an event whose event_id starts
# with "force_fail_" throws after correlation commits, so the retry -> DLQ ->
# findings.status='failed' branch is demonstrable end to end. Takes ~15s of real
# backoff to reach dead_letter. Off by default in code.
ENABLE_DEMO_FAILURE_TRIGGER=true
